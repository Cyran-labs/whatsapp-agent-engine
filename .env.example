# WABAGENT Engine : variables d'environnement

# --- Server ---
PORT=3800
BASE_URL=https://demo-wa.cyran.ai
NODE_ENV=development
# Adresse publique du moteur, sans barre finale. Optionnelle : sert à afficher l'URL de webhook complète
# d'un compte WhatsApp (sinon seul le chemin est donné).
PUBLIC_BASE_URL=

# --- Database (laisser vide pour fallback SQLite local) ---
DATABASE_URL=postgres://user:pass@localhost:5432/cyran_labs

# --- Auth back-office (API admin) ---
# Secret de signature des JWT d'accès (HS256). REQUIS pour le login/back-office.
# Sans lui, /auth/login renvoie 500. Generer : openssl rand -base64 48
ADMIN_JWT_SECRET=
# Durée de validité (jours) d'un lien d'invitation à usage unique. Défaut : 7.
ADMIN_INVITE_TTL_DAYS=7
# Origine de l'app web, utilisée pour construire le lien d'invitation écrit dans les journaux (ConsoleMailer).
ADMIN_WEB_ORIGIN=http://localhost:3000

# --- Credentials chiffrés par tenant ---
# Clé maître AES-256 (32 octets). Générer : openssl rand -hex 32
# Requise pour chiffrer/déchiffrer les credentials en DB.
CREDENTIALS_ENCRYPTION_KEY=

# --- LLM par défaut (overridable par tenant) ---
ANTHROPIC_API_KEY=
# Pool de clés plateforme (mode SaaS) : liste séparée par virgules. Si absent, ANTHROPIC_API_KEY sert de clé unique.
ANTHROPIC_API_KEYS=
# Concurrence max d'appels LLM en vol PAR CLIENT en mode platform (file d'attente au-delà, jamais de rejet).
LLM_CLIENT_CONCURRENCY=3
# Durée de mise en pause d'une clé du pool après un 429/529 (ms).
LLM_KEY_COOLDOWN_MS=30000

OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# --- Audio (Whisper via Groq) ---
GROQ_API_KEY=

# --- Webhooks ---
# Âge maximal (heures) d'un message entrant : au-delà il est ignoré. Défaut : 24.
# Borné à 167 : les clés de dédoublonnage sont conservées 168 h (7 jours), une valeur supérieure ou égale
# est ramenée à 167 avec un avertissement [Config].
MESSAGE_MAX_AGE_HOURS=24

# --- Maintenance ---
# Rétention des conversations, en jours (entier supérieur ou égal à 1). Défaut : 90.
# Une valeur invalide est ignorée (défaut utilisé) avec un avertissement [Config] au démarrage.
# La purge tourne au démarrage puis toutes les 6 h : les conversations plus anciennes sont supprimées.
CONVERSATION_RETENTION_DAYS=90

# --- Logs ---
LOG_LEVEL=info

# --- Transports WhatsApp ---
# Les identifiants WhatsApp (jeton d'accès, identifiant de numéro, secret d'application) sont stockés
# par agent IA dans la base de données : le moteur ne les lit jamais depuis ce fichier, et aucun n'est
# requis au démarrage. CM.com n'a aucune variable d'environnement.
# META_PHONE_NUMBER_ID, META_ACCESS_TOKEN, META_APP_SECRET et co. ne sont lues que par
# scripts/seed-credentials.ts (semis des identifiants). META_VERIFY_TOKEN est la seule variable Meta
# lue par le moteur (GET de vérification du webhook).
# Récupérer depuis Meta Business Manager → WhatsApp → Configuration API
META_PHONE_NUMBER_ID=
META_WABA_ID=
WA_PHONE_NUMBER=
META_ACCESS_TOKEN=
# Lu seulement par scripts/seed-credentials.ts (le secret de chaque agent IA vit en base).
META_APP_SECRET=
META_VERIFY_TOKEN=
# Version de l'API Graph (défaut v26.0). À relever avant la date d'expiration de la version utilisée.
META_GRAPH_VERSION=
