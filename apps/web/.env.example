# URL de base de l'API admin engine
ENGINE_API_URL=http://localhost:3000/api/admin/v1

# Taux dollar vers euro, fixé par la plateforme (optionnel). Anthropic facture en dollars : avec un taux valide,
# le back-office ajoute l'équivalent en euros aux coûts et indique le taux et sa date. Sans taux valide (absent,
# nul, négatif ou illisible), seuls les dollars sont affichés. Taux avec point décimal, date au format AAAA-MM-JJ.
# Lus côté serveur par le BFF, aucun appel externe.
# USD_EUR_RATE=0.92
# USD_EUR_RATE_DATE=2026-11-09
